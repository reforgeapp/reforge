# Copy to .env and fill in. Never commit the real .env.
POSTGRES_USER=reforge
POSTGRES_PASSWORD=
POSTGRES_DB=reforge

# Browser-visible origin. Must match the OIDC redirect URL.
REFORGE_PUBLIC_URL=http://127.0.0.1:8080

# Runtime role and schema-owner role. Use separate roles.
REFORGE_DATABASE_URL=postgres://reforge_runtime:CHANGE_ME@postgres:5432/reforge
REFORGE_MIGRATION_DATABASE_URL=postgres://reforge_owner:CHANGE_ME@postgres:5432/reforge

# base64-encoded 32-byte key material; store outside the image.
REFORGE_ENCRYPTION_KEY=
REFORGE_ENCRYPTION_KEY_ID=primary

REFORGE_EDITION=self-hosted
REFORGE_VERSION=dev

# Help links point here. Keep the trailing slash.
REFORGE_DOCS_URL=/docs/
REFORGE_DOCS_BIND=127.0.0.1:8082

# OIDC, or the one-time self-hosted bootstrap. Fixture auth is development only.
REFORGE_OIDC_ISSUER=
REFORGE_OIDC_CLIENT_ID=
REFORGE_OIDC_CLIENT_SECRET=
REFORGE_BOOTSTRAP_TOKEN=
REFORGE_BOOTSTRAP_EXPIRES_AT=

# Optional KMS envelope encryption instead of the local key.
REFORGE_KMS_REGION=
REFORGE_KMS_KEY_ARN=

# Host directory holding the runner credential file and runtime-config.json.
REFORGE_RUNNER_DIR=/var/lib/reforge-runner
