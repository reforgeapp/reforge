POSTGRES_USER=reforge
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
POSTGRES_DB=reforge

REFORGE_MIGRATOR_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
REFORGE_RUNTIME_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
REFORGE_MIGRATION_DATABASE_URL=postgres://reforge_migrator:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@postgres:5432/reforge
REFORGE_DATABASE_URL=postgres://reforge_runtime:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@postgres:5432/reforge

REFORGE_PUBLIC_URL=https://reforge.example.com
REFORGE_BIND=127.0.0.1:8080

REFORGE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
REFORGE_ENCRYPTION_KEY_ID=primary
REFORGE_EDITION=self-hosted
REFORGE_VERSION=dev
REFORGE_DOCS_URL=/docs/
REFORGE_DOCS_BIND=127.0.0.1:8082

REFORGE_OIDC_ISSUER=https://identity.example.com
REFORGE_OIDC_CLIENT_ID=reforge
REFORGE_OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
REFORGE_BOOTSTRAP_TOKEN=
REFORGE_BOOTSTRAP_EXPIRES_AT=

REFORGE_KMS_REGION=
REFORGE_KMS_KEY_ARN=

REFORGE_RUNNER_DIR=/var/lib/reforge-runner
